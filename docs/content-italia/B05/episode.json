      "promptAudioKey": "it-b05-p03",
      "promptPt": "简短地说出你住在哪里。现在请说。",
      "audioKey": "it-b05-t03",
      "es": "In un hotel a Roma.",
      "pinyin": "een oon o-TEL a RO-ma",
      "pt": "在罗马的一家酒店。",
      "tts": "In un hotel a Roma."
    },
    {
      "tipo": "ouvir",
      "voz": "target_it_m",
      "audioKey": "it-b05-r04",
      "es": "Ha la prenotazione?",
      "pt": "您有预订吗？",
      "tts": "Ha la prenotazione?"
    },
