      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_m",
      "promptAudioKey": "it-b05-p02",
      "promptPt": "只给出停留时长，别的都不说。现在请说。",
      "audioKey": "it-b05-t02",
      "es": "Dieci giorni.",
      "pinyin": "dee-EH-chee JOR-nee",
      "pt": "十天。",
      "tts": "Dieci giorni."
    },
    {
      "tipo": "ouvir",
      "voz": "target_it_m",
      "audioKey": "it-b05-r03",
      "es": "Dove alloggia?",
