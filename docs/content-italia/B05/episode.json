      "consulta": [
        "reparo/nao-entendi"
      ],
      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_f",
      "promptAudioKey": "it-b05-p05",
      "promptPt": "你没听清那个问题。干脆地问一遍，别道歉两次。现在请说。",
      "audioKey": "it-b05-t05",
      "es": "Scusi, non ho capito la domanda.",
      "pinyin": "SKOO-zee, non oh ka-PEE-to la do-MAN-da",
      "pt": "抱歉，我没听懂这个问题。",
      "tts": "Scusi, non ho capito la domanda."
    },
    {
      "consulta": [
        "chegar/imigracao"
      ],
      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_m",
      "promptAudioKey": "it-b05-p06",
      "promptPt": "说你是一个人旅行。现在请说。",
      "audioKey": "it-b05-t06",
      "es": "Viaggio da solo.",
      "pinyin": "vee-AJ-jo da SO-lo",
      "pt": "我一个人旅行。",
      "tts": "Viaggio da solo."
    },
