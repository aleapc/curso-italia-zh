        "chegar/imigracao",
        "chegar/motivo"
      ],
      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_f",
      "promptAudioKey": "it-b05-p01",
      "promptPt": "你是来度假的。一句话。现在请说。",
      "audioKey": "it-b05-t01",
      "es": "Sono in vacanza.",
      "pinyin": "SO-no een va-KAN-tsa",
      "pt": "我在度假。",
      "tts": "Sono in vacanza."
    },
    {
      "tipo": "ouvir",
      "voz": "target_it_m",
      "audioKey": "it-b05-r02",
      "es": "Quanto tempo si ferma?",
      "pt": "您要待多久？",
      "tts": "Quanto tempo si ferma?"
    },
    {
      "tipo": "intro",
      "voz": "guide_en_us_m",
      "audioKey": "it-b05-n02",
      "bloco": "corpo",
      "pt": "用你真实的数字。十天是练习用的值，不是每趟旅行都要背下来的一句话。"
    },
    {
      "consulta": [
        "chegar/duracao"
