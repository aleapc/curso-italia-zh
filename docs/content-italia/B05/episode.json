      "es": "Grazie, buongiorno.",
      "pinyin": "GRA-tsee-eh, bwon-JOR-no",
      "pt": "谢谢，再见。",
      "tts": "Grazie, buongiorno."
    },
    {
      "tipo": "shadow",
      "voz": "target_it_f",
      "audioKey": "it-b05-s01",
      "es": "Sono in vacanza. Dieci giorni. In un hotel a Roma. Sì, eccola.",
      "pinyin": "SO-no een va-KAN-tsa. dee-EH-chee JOR-nee. een oon o-TEL a RO-ma. see, EK-ko-la",
      "pt": "把这三个回答跟读一遍，每句之后都干脆地停一下。",
      "tts": "Sono in vacanza. Dieci giorni. In un hotel a Roma. Sì, eccola."
    },
    {
      "tipo": "recap",
      "voz": "guide_en_us_f",
      "audioKey": "it-b05-n05",
      "bloco": "recap",
      "pt": "B05 完成。来意、停留时长、住哪儿。简短不等于回避——简短意味着回答对上了问题。"
    }
