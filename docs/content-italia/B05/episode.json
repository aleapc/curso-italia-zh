      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_f",
      "promptAudioKey": "it-b05-p07",
      "promptPt": "他们问你是否还去别的城市。简短而真实地回答。现在请说。",
      "audioKey": "it-b05-t07",
      "es": "Poi vado a Firenze.",
      "pinyin": "poy VA-do a fee-REN-tse",
      "pt": "之后我去佛罗伦萨。",
      "tts": "Poi vado a Firenze."
    },
    {
      "tipo": "ouvir",
      "voz": "target_it_m",
      "audioKey": "it-b05-r05",
      "es": "Va bene. Buon viaggio.",
      "pt": "好的。旅途愉快。",
      "tts": "Va bene. Buon viaggio."
    },
    {
      "consulta": [
        "simpatia/agradecer"
      ],
      "tipo": "responde",
      "voz": "target_it_f",
      "promptVoz": "guide_en_us_m",
      "promptAudioKey": "it-b05-p08",
      "promptPt": "用两个词收尾，然后走开。现在请说。",
